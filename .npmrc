# dsh profile convention: the @deepseek-ai/* and cordis peer dependencies
# resolve from the dsh installation at runtime (in-box bundles), never from
# the npm registry. Disable auto-install-peers so a local `pnpm install`
# does not try to fetch unpublished packages. Dev-time resolution of the
# private packages is wired by scripts/setup-dsh-links.mjs from the
# $DSH_SOURCE_DIR / $DSH_HOME source tree (see README, Development).
auto-install-peers=false

# Flat node_modules (dsh profile convention): without per-package .pnpm
# shadowing, node resolution — including externalized CJS deps such as
# testing-library — reaches the link farm's react / react-dom identity links.
node-linker=hoisted

// @deepseek-ai:registry=https://registry.npmjs.org/
//registry.npmjs.org/:_authToken=${NPM_TOKEN}
