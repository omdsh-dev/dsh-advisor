{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Browser half: JSX via the automatic runtime (react/jsx-runtime stays a
    // loader-table external) and the DOM libs the client code compiles against.
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Client sources import siblings with explicit .ts/.tsx extensions
    // (dsh-private convention); legal under emitDeclarationOnly / noEmit.
    "allowImportingTsExtensions": true,
    // Used in two modes:
    // - build (scripts/build-client.mjs): declaration-only emit into lib/client/
    //   (the bundle is esbuild's, the .d.ts tree is tsc's);
    // - typecheck (`tsc -p tsconfig.client.json --noEmit`): the CLI flag wins
    //   over these two and nothing is emitted.
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "sourceMap": false,
    // rootDir is the whole src/ (not just src/client) because the flat card
    // imports the SSOT prompt constant from src/prompts.ts (the textarea
    // placeholder — plan dsh-advisor-web-config-flat-n10); a src/client
    // rootDir would reject that import (TS6059). src/ keeps the emitted
    // layout stable: src/client/** still lands in lib/client/**, and the
    // shared prompts.ts emits only its (main build-identical) declaration.
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": ["src/client", "src/prompts.ts"],
  // The base program excludes src/client (node side); this client program
  // re-includes it, so the inherited exclude must be cleared.
  "exclude": []
}
