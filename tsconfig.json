{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    // skipLibCheck is kept enabled as a defensive guard: it avoids TS6200-style
    // declaration collisions from the dependency graph and keeps the typecheck
    // focused on src/ and tests/, which remain fully strict-checked. Removal is
    // deferred to the settings plan's full regression (its T1 may re-attempt it).
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "tests"],
  // The client half (src/client) typechecks under tsconfig.client.json (jsx:
  // react-jsx + DOM libs); this node-side program excludes it so `tsc --noEmit`
  // never sees the .tsx sources without the JSX flag.
  "exclude": ["src/client"]
}
