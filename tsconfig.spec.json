{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Component specs render React (JSX via the automatic runtime) under
    // jsdom and drive @testing-library/react, so this program needs the JSX
    // flag and the DOM libs the base node program deliberately omits. The
    // client sources they import (src/client/*.tsx) compile under the same
    // flags here, mirroring tsconfig.client.json's setup.
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // The client sources the specs import (src/client) reference siblings with
    // explicit .ts/.tsx extensions (bundler resolution — dsh-private
    // convention); allowImportingTsExtensions legalizes those imports under
    // this program. The specs themselves import extensionless.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["tests/**/*.spec.tsx", "src/client/css-modules.d.ts"],
  // The base program excludes src/client; this spec program must see the
  // client sources the specs import, so the inherited exclude is cleared
  // (same as tsconfig.client.json).
  "exclude": []
}
